<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{6E2B9C1A-3F4D-4E8B-9A71-0C5D2F8E4B13}</ProjectGuid>
    <RootNamespace>dlssg_to_xefg</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <!-- The installed Visual Studio's own toolset (v145 for VS 2026), so CI runners with an older VS build it too -->
    <PlatformToolset>$(DefaultPlatformToolset)</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <WholeProgramOptimization Condition="'$(Configuration)'=='Release'">true</WholeProgramOptimization>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <TargetName>dlssg_to_xefg_intel_is_better</TargetName>
    <OutDir>$(SolutionDir)bin\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)obj\$(Configuration)\</IntDir>
    <XeFgProgramsDir>$(OutDir)xefg_mfg_programs</XeFgProgramsDir>
    <XeFgCudaSha256 Condition="'$(XeFgCudaSha256)' == ''"></XeFgCudaSha256>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <PreprocessorDefinitions>WIN32_LEAN_AND_MEAN;NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- Static CRT: we can be loaded from any folder, a dll we'd depend on might not be found there -->
      <RuntimeLibrary Condition="'$(Configuration)'=='Debug'">MultiThreadedDebug</RuntimeLibrary>
      <RuntimeLibrary Condition="'$(Configuration)'=='Release'">MultiThreaded</RuntimeLibrary>
      <FunctionLevelLinking Condition="'$(Configuration)'=='Release'">true</FunctionLevelLinking>
      <IntrinsicFunctions Condition="'$(Configuration)'=='Release'">true</IntrinsicFunctions>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalDependencies>d3d12.lib;dxgi.lib;bcrypt.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <EnableCOMDATFolding Condition="'$(Configuration)'=='Release'">true</EnableCOMDATFolding>
      <OptimizeReferences Condition="'$(Configuration)'=='Release'">true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="src\Exports.cpp" />
    <ClCompile Include="src\FrameGenerator.cpp" />
    <ClCompile Include="src\Log.cpp" />
    <ClCompile Include="src\MfgKernels.cpp" />
    <ClCompile Include="src\MfgPort\RuntimePayload.cpp" />
    <ClCompile Include="src\MfgPort\Cuda\cuda_route.cpp" />
    <ClCompile Include="src\Plugin.cpp" />
    <ClCompile Include="src\XeFG.cpp" />
    <ClCompile Include="src\XeFGLoader.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="src\FrameGenerator.h" />
    <ClInclude Include="src\Log.h" />
    <ClInclude Include="src\MfgKernels.h" />
    <ClInclude Include="src\MfgPort\MfgPortLog.h" />
    <ClInclude Include="src\MfgPort\ModelPort.h" />
    <ClInclude Include="src\MfgPort\RuntimeLayout.generated.h" />
    <ClInclude Include="src\MfgPort\RuntimeLayout.h" />
    <ClInclude Include="src\MfgPort\RuntimePayload.h" />
    <ClInclude Include="src\MfgPort\Sha256.h" />
    <ClInclude Include="src\MfgPort\ShaderPort.h" />
    <ClInclude Include="src\MfgPort\Cuda\AdapterDiscovery.h" />
    <ClInclude Include="src\MfgPort\Cuda\cuda_route.h" />
    <ClInclude Include="src\MfgPort\Cuda\OverlayNative.h" />
    <ClInclude Include="src\MfgPort\Cuda\xefg_cuda_params.h" />
    <ClInclude Include="src\NGX.h" />
    <ClInclude Include="src\optiscaler_plugin.h" />
    <ClInclude Include="src\Plugin.h" />
    <ClInclude Include="src\Util.h" />
    <ClInclude Include="src\XeFG.h" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <!-- The ported XeSS MFG programs and the tensor-core fatbin are Intel/MFG-Unlocker build data, so they stay out of
       the repo. This extracts the pinned set and fatbin from MFG-Unlocker's release dll into the runtime folder. -->
  <Target Name="GenerateXeFgPrograms" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <Message Importance="high" Text="Generating the XeFG MFG program set..." />
    <Exec Command="powershell -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\tools\GenerateXeFgPrograms.ps1&quot; -Output &quot;$(XeFgProgramsDir)&quot; -Cache &quot;$(IntDir)packages&quot; -Dll &quot;$(MfgUnlockerDll)&quot;" />
  </Target>
  <!-- Optional: rebuild the tensor-core fatbin from source. By default GenerateXeFgPrograms extracts the pinned,
       validated fatbin from MFG-Unlocker's release dll; without CudaRoot this target is skipped. -->
  <Target Name="GenerateXeFgCuda" AfterTargets="Build" DependsOnTargets="GenerateXeFgPrograms" Condition="'$(DesignTimeBuild)' != 'true' and '$(CudaRoot)' != ''">
    <Message Importance="high" Text="Generating the XeFG tensor-core kernel fatbin..." />
    <Exec Command="powershell -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\tools\GenerateXeFgCuda.ps1&quot; -Output &quot;$(XeFgProgramsDir)&quot; -CudaRoot &quot;$(CudaRoot)&quot; -Source &quot;$(MSBuildProjectDirectory)\src\MfgPort\Cuda&quot; -VcVars &quot;$(VCInstallDir)Auxiliary\Build\vcvars64.bat&quot; -VcVarsVersion &quot;$(VCToolsVersion)&quot; -ExpectedSha256 &quot;$(XeFgCudaSha256)&quot;" />
  </Target>
  <Target Name="ReportXeFgCudaSkipped" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true' and '$(CudaRoot)' == ''">
    <Message Importance="normal" Text="CUDA source rebuild not configured; using the extracted XeFG tensor-core fatbin." />
  </Target>
</Project>
